# Copy to the local Confluence MCP directory as .env. Never commit the filled file.
CONFLUENCE_PAT=<your-confluence-personal-access-token>
CONFLUENCE_BASE_URL=https://<confluence-host>/confluence
HTTP_PROXY=http://<proxy-host>:<http-port>
HTTPS_PROXY=http://<proxy-host>:<https-port>
CONFLUENCE_HOME_SPACE=PVCS
MCP_TRANSPORT=http
MCP_PORT=8001
