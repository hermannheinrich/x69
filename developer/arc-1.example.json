{
  "name": "arc-1",
  "type": "stdio",
  "command": "npx",
  "args": ["arc-1@latest"],
  "env": {
    "SAP_URL": "https://e69.sap.porsche.biz",
    "SAP_CLIENT": "100",
    "SAP_LANGUAGE": "DE",
    "SAP_SYSTEM_TYPE": "onprem",
    "SAP_ABAP_RELEASE": "758",
    "NODE_EXTRA_CA_CERTS": "<HOME>/.config/opencode/certs/e69-chain.pem",
    "SAP_COOKIE_FILE": "<HOME>/.config/opencode/certs/e69.cookies",
    "SAP_DISABLE_SAML": "true",
    "SAP_ALLOW_WRITES": "true",
    "SAP_ALLOW_TRANSPORT_WRITES": "true",
    "SAP_ALLOWED_PACKAGES": "Y*,$TMP",
    "SAP_DENY_ACTIONS": "SAPTransport.release",
    "ARC1_LOG_LEVEL": "info"
  }
}